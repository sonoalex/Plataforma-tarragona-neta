---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import ConcentracioModal from '../components/ConcentracioModal.astro';
import heroImg from '../../assets/hero-image.jpeg';
import imgContenidorsDesbordats from '../../assets/contenidors-desbordats.webp';
import imgDenunciaContenidors from '../../assets/denuncia-contenidors-part-alta.jpg';
import imgDenunciaMobles from '../../assets/mobiliari-abocat.jpeg';
import imgDenunciaRuna from '../../assets/denuncia-runa-escombros.jpg';
import imgDenunciaFont from '../../assets/denuncia-font-degradada.jpeg';
import imgDenunciaResidus from '../../assets/denuncia-carrer-residus.jpg';
---

<Layout 
  title="Tarragona Neta | Plataforma Veïnal contra la brutícia i l'abandonament"
  description="Plataforma ciutadana i veïnal per denunciar la brutícia urbana, l'acumulació incontrolada de residus i la insalubritat als carrers de Tarragona."
  lang="ca"
>
  <!-- Modal Convocatòria Concentració -->
  <ConcentracioModal lang="ca" />

  <!-- Hero Section -->
  <section class="grid grid-cols-1 lg:grid-cols-12 min-h-[90vh] border-b-4 border-zinc-950 bg-zinc-100">
    <!-- Left Hero Content -->
    <div class="lg:col-span-7 p-6 md:p-12 lg:p-16 flex flex-col justify-center border-b-4 lg:border-b-0 lg:border-r-4 border-zinc-950">
      <div class="max-w-3xl">
        <!-- Badge -->
        <span class="inline-block bg-yellow-400 text-zinc-950 font-black uppercase text-xs tracking-wider px-3 py-1 border-2 border-zinc-950 shadow-[2px_2px_0px_0px_rgba(9,9,11,1)] mb-6">
          ALERTA CIUTADANA
        </span>
        
        <h1 class="text-6xl md:text-8xl lg:text-[6.5vw] font-black uppercase leading-[0.85] tracking-tighter text-zinc-950">
          <span class="hero-word-reveal inline-block">Exigim</span> <br />
          <span class="hero-word-reveal text-red-600 inline-block">Solucions.</span> <br />
          <span class="hero-word-reveal inline-block">No excuses.</span>
        </h1>
        
        <p class="mt-8 text-xl md:text-2xl font-medium leading-relaxed tracking-tight text-zinc-800">
          Tarragona Neta és una plataforma ciutadana creada per denunciar la brutícia urbana, l'acumulació incontrolada de residus i la insalubritat als nostres carrers.
        </p>

        <!-- CTA Buttons -->
        <div class="mt-10 flex flex-col sm:flex-row gap-4">
          <a 
            href="#signar" 
            class="inline-flex items-center justify-between bg-zinc-950 text-white px-8 py-5 text-lg font-black uppercase tracking-widest hover:bg-red-600 hover:text-white transition-colors border-2 border-zinc-950 shadow-[5px_5px_0px_0px_rgba(220,38,38,1)] active:translate-x-1 active:translate-y-1 active:shadow-[1px_1px_0px_0px_rgba(220,38,38,1)]"
          >
            <span>Signar Manifest</span>
            <svg class="ml-4 w-6 h-6" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
            </svg>
          </a>
          <a 
            href="#plataforma" 
            class="inline-flex items-center justify-center border-4 border-zinc-950 text-zinc-950 bg-white px-8 py-5 text-lg font-black uppercase tracking-widest hover:bg-zinc-950 hover:text-white transition-colors shadow-[5px_5px_0px_0px_rgba(9,9,11,1)] active:translate-x-1 active:translate-y-1 active:shadow-[1px_1px_0px_0px_rgba(9,9,11,1)]"
          >
            <span>La Plataforma</span>
          </a>
        </div>
      </div>
    </div>

    <!-- Right Hero Stats / Image Overlay -->
    <div class="lg:col-span-5 flex flex-col justify-between bg-zinc-950 text-white min-h-[50vh] lg:min-h-full">
      <!-- High contrast image with color blend -->
      <div class="relative flex-1 min-h-[250px] lg:min-h-[auto] overflow-hidden border-b-4 border-zinc-950">
        <Image 
          src={heroImg} 
          alt="Carrer descuidat amb residus a Tarragona"
          loading="eager"
          fetchpriority="high"
          class="absolute inset-0 w-full h-full object-cover grayscale contrast-125 brightness-75"
        />
        <div class="absolute inset-0 bg-red-700 mix-blend-multiply opacity-25"></div>
        <div class="absolute bottom-4 left-4 bg-zinc-950 text-white font-mono text-[10px] tracking-widest px-2 py-0.5 border border-zinc-800">
          PLAÇA DE LA FONT, NOVEMBRE 2025
        </div>
      </div>
      
      <!-- Stats Board -->
      <div class="p-6 md:p-8 bg-zinc-950 border-t-2 border-zinc-900 grid grid-cols-2 gap-4 md:gap-6">
        <div class="border-2 border-zinc-800 p-4 bg-zinc-900/50">
          <span class="block text-zinc-500 font-bold text-[10px] tracking-wider uppercase">Signatures Change.org</span>
          <span class="text-3xl md:text-4xl font-black text-red-500 tracking-tight">2.590</span>
        </div>
        <div class="border-2 border-zinc-800 p-4 bg-zinc-900/50">
          <span class="block text-zinc-500 font-bold text-[10px] tracking-wider uppercase">Grups de Treball</span>
          <span class="text-3xl md:text-4xl font-black text-yellow-400 tracking-tight">4</span>
        </div>
        <div class="border-2 border-zinc-800 p-4 bg-zinc-900/50">
          <span class="block text-zinc-500 font-bold text-[10px] tracking-wider uppercase">Promotors Veïnals</span>
          <span class="text-3xl md:text-4xl font-black text-white tracking-tight">6</span>
        </div>
        <div class="border-2 border-zinc-800 p-4 bg-zinc-900/50">
          <span class="block text-zinc-500 font-bold text-[10px] tracking-wider uppercase">Estatus Campanya</span>
          <span class="text-lg md:text-xl font-black text-zinc-950 bg-yellow-400 px-2 py-1 inline-block uppercase text-center w-full mt-1">En Lluita</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Horizontal Scroll Section (Pinned horror gallery) -->
  <section id="gallery-container" class="relative bg-zinc-950 text-white border-b-4 border-zinc-950 overflow-hidden h-screen flex flex-col justify-between">
    <!-- Header inside pinning section -->
    <div class="p-6 md:p-12 w-full flex flex-col sm:flex-row sm:items-end justify-between z-10 bg-gradient-to-b from-zinc-950 to-transparent">
      <div>
        <span class="text-red-500 font-black tracking-widest text-xs uppercase block mb-2">ARXIU VISUAL DE LA DEIXADESA</span>
        <h2 class="text-4xl md:text-6xl font-black uppercase tracking-tighter">La Realitat del Nostre Abast</h2>
      </div>
      <p class="text-zinc-400 font-medium max-w-sm mt-4 sm:mt-0 text-sm">
        Fes scroll cap avall per lliscar lateralment a través de les denúncies reals recopilades pels veïns.
      </p>
    </div>

    <!-- Scrolling Track -->
    <div id="gallery-scroll" class="flex w-[400vw] h-[65vh] items-center shrink-0">
      
      <!-- Slide 1 -->
      <div class="gallery-item w-screen h-full px-4 md:px-12 flex items-center justify-center shrink-0">
        <div class="grid grid-cols-1 md:grid-cols-12 w-full max-w-6xl gap-4 md:gap-6 border-4 border-zinc-800 bg-zinc-900/60 p-4 sm:p-6 md:p-10 relative">
          <div class="md:col-span-7 h-[160px] sm:h-[220px] md:h-[400px] bg-zinc-800 relative overflow-hidden">
            <Image src={imgDenunciaContenidors} class="w-full h-full object-cover filter grayscale contrast-125" alt="Contenidors desbordats a la Part Alta" />
            <div class="absolute inset-0 bg-red-600 mix-blend-multiply opacity-10"></div>
          </div>
          <div class="md:col-span-5 flex flex-col justify-between py-1">
            <div>
              <span class="bg-red-600 text-zinc-950 font-black text-[10px] sm:text-xs px-2.5 py-0.5 sm:px-3 sm:py-1 uppercase tracking-wider inline-block mb-3 sm:mb-4">INFORME #042</span>
              <h3 class="text-xl sm:text-2xl md:text-5xl font-black uppercase leading-none mb-2 sm:mb-4">Contenidors Desbordats</h3>
              <p class="text-zinc-400 text-xs sm:text-base md:text-lg leading-relaxed">
                L'acumulació sistemàtica de bosses de brossa fora dels contenidors genera males olors i l'aparició de plagues de rosegadors.
              </p>
            </div>
            <div class="mt-4 pt-4 md:mt-6 md:pt-6 border-t border-zinc-800 flex justify-between items-center text-xs font-mono">
              <span class="text-yellow-400">Part Alta // Casc Antic</span>
              <span class="text-zinc-500">12 Octubre</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Slide 2 -->
      <div class="gallery-item w-screen h-full px-4 md:px-12 flex items-center justify-center shrink-0">
        <div class="grid grid-cols-1 md:grid-cols-12 w-full max-w-6xl gap-4 md:gap-6 border-4 border-zinc-800 bg-zinc-900/60 p-4 sm:p-6 md:p-10 relative">
          <div class="md:col-span-7 h-[160px] sm:h-[220px] md:h-[400px] bg-zinc-800 relative overflow-hidden">
            <Image src={imgDenunciaMobles} class="w-full h-full object-cover filter grayscale contrast-125" alt="Mobiliari i trastos abandonats" />
            <div class="absolute inset-0 bg-red-600 mix-blend-multiply opacity-10"></div>
          </div>
          <div class="md:col-span-5 flex flex-col justify-between py-1">
            <div>
              <span class="bg-red-600 text-zinc-950 font-black text-[10px] sm:text-xs px-2.5 py-0.5 sm:px-3 sm:py-1 uppercase tracking-wider inline-block mb-3 sm:mb-4">INFORME #089</span>
              <h3 class="text-xl sm:text-2xl md:text-5xl font-black uppercase leading-none mb-2 sm:mb-4">Trastos i Mobles Vells</h3>
              <p class="text-zinc-400 text-xs sm:text-base md:text-lg leading-relaxed">
                Matalassos, somiers i mobles vells bloquejant les voreres i passos de vianants durant setmanes sense resposta dels serveis municipals.
              </p>
            </div>
            <div class="mt-4 pt-4 md:mt-6 md:pt-6 border-t border-zinc-800 flex justify-between items-center text-xs font-mono">
              <span class="text-yellow-400">Centre // Eixample</span>
              <span class="text-zinc-500">15 Octubre</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Slide 3 -->
      <div class="gallery-item w-screen h-full px-4 md:px-12 flex items-center justify-center shrink-0">
        <div class="grid grid-cols-1 md:grid-cols-12 w-full max-w-6xl gap-4 md:gap-6 border-4 border-zinc-800 bg-zinc-900/60 p-4 sm:p-6 md:p-10 relative">
          <div class="md:col-span-7 h-[160px] sm:h-[220px] md:h-[400px] bg-zinc-800 relative overflow-hidden">
            <Image src={imgDenunciaRuna} class="w-full h-full object-cover filter grayscale contrast-125" alt="Runes d'obra abandonades" />
            <div class="absolute inset-0 bg-red-600 mix-blend-multiply opacity-10"></div>
          </div>
          <div class="md:col-span-5 flex flex-col justify-between py-1">
            <div>
              <span class="bg-red-600 text-zinc-950 font-black text-[10px] sm:text-xs px-2.5 py-0.5 sm:px-3 sm:py-1 uppercase tracking-wider inline-block mb-3 sm:mb-4">INFORME #104</span>
              <h3 class="text-xl sm:text-2xl md:text-5xl font-black uppercase leading-none mb-2 sm:mb-4">Abocament de Runes</h3>
              <p class="text-zinc-400 text-xs sm:text-base md:text-lg leading-relaxed">
                Caixes amb rajoles trencades, enderrocs i materials d'obra dipositats a la via pública creant perill per als vianants.
              </p>
            </div>
            <div class="mt-4 pt-4 md:mt-6 md:pt-6 border-t border-zinc-800 flex justify-between items-center text-xs font-mono">
              <span class="text-yellow-400">Campclar // Rambla Ponent</span>
              <span class="text-zinc-500">18 Octubre</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Slide 4 -->
      <div class="gallery-item w-screen h-full px-4 md:px-12 flex items-center justify-center shrink-0">
        <div class="grid grid-cols-1 md:grid-cols-12 w-full max-w-6xl gap-4 md:gap-6 border-4 border-zinc-800 bg-zinc-900/60 p-4 sm:p-6 md:p-10 relative">
          <div class="md:col-span-7 h-[160px] sm:h-[220px] md:h-[400px] bg-zinc-800 relative overflow-hidden">
            <Image src={imgDenunciaFont} class="w-full h-full object-cover filter grayscale contrast-125" alt="Degradació de fonts públiques" />
            <div class="absolute inset-0 bg-red-600 mix-blend-multiply opacity-10"></div>
          </div>
          <div class="md:col-span-5 flex flex-col justify-between py-1">
            <div>
              <span class="bg-red-600 text-zinc-950 font-black text-[10px] sm:text-xs px-2.5 py-0.5 sm:px-3 sm:py-1 uppercase tracking-wider inline-block mb-3 sm:mb-4">INFORME #121</span>
              <h3 class="text-xl sm:text-2xl md:text-5xl font-black uppercase leading-none mb-2 sm:mb-4">Degradació Mobiliari Urbà</h3>
              <p class="text-zinc-400 text-xs sm:text-base md:text-lg leading-relaxed">
                Fonts públiques d'aigua potable completament oxidades, bancs trencats i instal·lacions urbanes sense manteniment ni salubritat als espais públics.
              </p>
            </div>
            <div class="mt-4 pt-4 md:mt-6 md:pt-6 border-t border-zinc-800 flex justify-between items-center text-xs font-mono">
              <span class="text-yellow-400">Parc Francolí // Zona Verda</span>
              <span class="text-zinc-500">22 Octubre</span>
            </div>
          </div>
        </div>
      </div>

    </div>

    <!-- Scroll progress bar and details -->
    <div class="w-full bg-zinc-900 border-t-2 border-zinc-800 p-4 md:px-12 flex justify-between items-center z-10">
      <div class="hidden sm:flex items-center gap-4 text-xs font-mono text-zinc-500 uppercase">
        <span>01 // Part Alta</span>
        <span>02 // Centre</span>
        <span>03 // Campclar</span>
        <span>04 // Parc Francolí</span>
      </div>
      <!-- Progress Bar Track -->
      <div class="w-full sm:w-48 md:w-64 h-1.5 bg-zinc-800 overflow-hidden relative">
        <div id="scroll-progress" class="absolute inset-y-0 left-0 w-full bg-red-600 origin-left scale-x-0"></div>
      </div>
    </div>
  </section>

  <!-- Initiatives and Origin Section -->
  <section class="border-b-4 border-zinc-950 bg-white py-16 px-6 md:px-12">
    <div class="max-w-6xl mx-auto">
      <span class="text-red-600 font-black tracking-widest text-xs uppercase block mb-3">L'ORIGEN DE LA LLUITA</span>
      <h2 class="text-4xl md:text-6xl font-black uppercase tracking-tighter leading-none mb-12">
        Iniciatives Ciutadanes
      </h2>
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
        <!-- Monica Card -->
        <div class="lg:col-span-5 border-4 border-zinc-950 bg-yellow-400 p-8 shadow-[6px_6px_0px_0px_rgba(9,9,11,1)] flex flex-col justify-between">
          <div>
            <span class="bg-zinc-950 text-white font-mono text-xs px-2.5 py-1 uppercase tracking-wider inline-block mb-6">Fundadora</span>
            <h3 class="text-3xl font-black uppercase leading-none mb-4">Mónica Novés Nadal</h3>
            <p class="text-zinc-900 font-bold text-sm uppercase tracking-wide mb-6">Metgessa i veïna de Tarragona</p>
            <p class="text-zinc-950 text-base md:text-lg leading-relaxed font-medium">
              Davant la passivitat de l'administració i el deteriorament de la ciutat, va decidir liderar la defense del dret a un entorn saludable iniciant una recollida de signatures a Change.org i impulsant la creació de la Plataforma.
            </p>
          </div>
          <div class="mt-8 border-t-2 border-zinc-950 pt-4 text-xs font-mono uppercase text-zinc-900 flex justify-between">
            <span>2 Iniciatives Actives</span>
            <span>Tarragona, 2026</span>
          </div>
        </div>

        <!-- Initiatives Details -->
        <div class="lg:col-span-7 flex flex-col gap-6 justify-between">
          <!-- Change.org Petition -->
          <div class="border-4 border-zinc-950 bg-zinc-100 p-6 md:p-8 shadow-[6px_6px_0px_0px_rgba(9,9,11,1)] flex flex-col justify-between h-full">
            <div>
              <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-6">
                <div>
                  <span class="text-red-600 font-bold text-xs uppercase tracking-widest block">INICIATIVA 01</span>
                  <h4 class="text-2xl font-black uppercase tracking-tight">Petició a Change.org</h4>
                </div>
                <a 
                  href="https://www.change.org/tarragonalimpia" 
                  target="_blank" 
                  rel="noopener noreferrer" 
                  class="bg-red-600 text-white font-black text-xs uppercase tracking-widest px-4 py-2 border-2 border-zinc-950 shadow-[3px_3px_0px_0px_rgba(9,9,11,1)] hover:bg-zinc-950 transition-colors"
                >
                  Signar a Change.org
                </a>
              </div>
              
              <p class="text-zinc-800 text-base mb-6 font-medium">
                Sota el lema <strong class="text-zinc-950">"No más suciedad en Tarragona"</strong>, aquesta campanya ha reunit més de <span class="bg-red-600 text-white font-black px-1.5 py-0.5">2.590 signatures</span> de veïns que exigeixen solucions immediates.
              </p>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 border-t-2 border-zinc-950 pt-6">
              <div>
                <span class="block text-zinc-500 font-black text-[10px] tracking-wider uppercase mb-2">Objectius de la Petició</span>
                <ul class="text-xs font-bold space-y-1.5 uppercase text-zinc-800">
                  <li class="flex items-center gap-2"><span class="w-1.5 h-1.5 bg-red-600"></span> Intensificar neteja de carrers</li>
                  <li class="flex items-center gap-2"><span class="w-1.5 h-1.5 bg-red-600"></span> Vigilància i sancions efectives</li>
                </ul>
              </div>
              <div class="sm:pt-6">
                <ul class="text-xs font-bold space-y-1.5 uppercase text-zinc-800">
                  <li class="flex items-center gap-2"><span class="w-1.5 h-1.5 bg-red-600"></span> Zones adaptades per a mascotes</li>
                  <li class="flex items-center gap-2"><span class="w-1.5 h-1.5 bg-red-600"></span> Educació i conscienciació</li>
                </ul>
              </div>
            </div>
          </div>

          <!-- The Platform Creation -->
          <div class="border-4 border-zinc-950 bg-zinc-950 text-white p-6 md:p-8 shadow-[6px_6px_0px_0px_rgba(9,9,11,1)]">
            <span class="text-yellow-400 font-bold text-xs uppercase tracking-widest block">INICIATIVA 02</span>
            <h4 class="text-2xl font-black uppercase tracking-tight mb-4 text-white">Plataforma per una Tarragona Neta</h4>
            <p class="text-zinc-300 text-sm md:text-base leading-relaxed font-medium">
              Estructura veïnal permanent per donar continuïtat a la pressió ciutadana, organitzar grups de treball i fiscalitzar de forma constant el compliment del contracte municipal de neteja.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Context and Before/After Split Screen Section -->
  <section class="grid grid-cols-1 lg:grid-cols-2 border-b-4 border-zinc-950 bg-zinc-950 text-zinc-50">
    <div class="p-8 md:p-12 lg:p-16 flex flex-col justify-center border-b-4 lg:border-b-0 lg:border-r-4 border-zinc-950">
      <span class="text-red-500 font-black tracking-widest text-xs uppercase block mb-3">EL COMPROMÍS FALTANT</span>
      <h2 class="text-4xl md:text-6xl font-black uppercase tracking-tighter leading-none mb-6 scroll-reveal">
        Deixadesa i<br/><span class="text-red-500">insalubritat.</span>
      </h2>
      <div class="space-y-4 text-sm md:text-base font-medium leading-relaxed text-zinc-300 scroll-reveal">
        <p>
          Actualment, a Tarragona ens trobem amb un greu problema de deixadesa, brutícia i insalubritat generalitzat a tot el centre i els seus barris. Només cal sortir a fer un tomb per observar la brossa que vessa dels contenidors i omple les vies públiques, generant no només una imatge indigna, sinó també males olors, plagues i riscos sanitaris intolerables.
        </p>
        <p class="border-l-4 border-red-600 pl-4 py-1 text-zinc-400 italic font-normal">
          Aquesta situació és fruit de l'incivisme d'alguns ciutadans combinat amb la greu deficiència dels serveis de neteja de l'Ajuntament, el qual incompleix reiteradament les seves obligacions de garantir la neteja, sostenibilitat i qualitat del medi ambient i la salut pública.
        </p>
        <p class="text-xs uppercase font-mono tracking-wider text-yellow-400 pt-2">
          Drets vulnerats: Arts. 27-30 Estatut d'Autonomia de Catalunya // Art. 26 LRBRL
        </p>
      </div>
    </div>
    <div class="p-6 md:p-12 flex flex-col items-center justify-center bg-zinc-900">
      <div class="relative w-full h-[450px] md:h-[520px] border-4 border-zinc-950 bg-zinc-950 overflow-hidden shadow-[8px_8px_0px_0px_rgba(220,38,38,1)] group">
        <Image 
          src={imgContenidorsDesbordats} 
          class="w-full h-full object-cover filter contrast-110 brightness-95 group-hover:scale-105 transition-transform duration-500" 
          alt="Contenidors desbordats a Tarragona durant la nit"
        />
        <div class="absolute top-4 left-4 bg-red-600 text-white px-3 py-1 font-black uppercase text-xs border-2 border-zinc-950 shadow-[2px_2px_0px_0px_rgba(9,9,11,1)]">
          REALITAT DOCUMENTADA
        </div>
        <div class="absolute bottom-4 left-4 right-4 bg-zinc-950/90 backdrop-blur-sm p-4 border-2 border-zinc-700 text-xs font-mono text-zinc-300 flex flex-col sm:flex-row justify-between sm:items-center gap-2">
          <span class="text-yellow-400 font-bold uppercase">Col·lapse de residus nocturn</span>
          <span class="text-zinc-400">Punts negres de recollida a Tarragona</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Marc Legal i Drets Section -->
  <section class="bg-zinc-900 text-white py-16 px-6 border-b-4 border-zinc-950">
    <div class="max-w-6xl mx-auto">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <span class="bg-red-600 text-white text-xs font-black px-3 py-1 uppercase tracking-widest inline-block mb-4 shadow-[2px_2px_0px_0px_rgba(255,255,255,1)]">
          MARC JURÍDIC i DRETS FONAMENTALS
        </span>
        <h2 class="text-3xl md:text-5xl font-black uppercase tracking-tighter leading-none text-white">
          El Dret a Viure en un Entorn Net
