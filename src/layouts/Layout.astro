---
import '../index.css';
import logoImg from '../../assets/logo.jpg';
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';

interface Props {
  title: string;
  description: string;
  lang: 'ca' | 'es';
}

const { title, description, lang } = Astro.props;

const t = {
  ca: {
    headerBadge: "Plataforma Veïnal",
    footerRights: "Plataforma per una Tarragona Neta.",
    footerTagline: "Per una ciutat digna per als seus veïns.",
    legal: "Avís Legal",
    contact: "Contacte",
    brand: "Tarragona Neta",
    navPlan: "El Pla",
    navPlatform: "La Plataforma",
    navParticipate: "Participa",
    navSign: "Signar",
    madeBy: "Fet altruistament per"
  },
  es: {
    headerBadge: "Plataforma Vecinal",
    footerRights: "Plataforma per una Tarragona Neta.",
    footerTagline: "Por una ciudad digna para sus vecinos.",
    legal: "Aviso Legal",
    contact: "Contacto",
    brand: "Tarragona Neta",
    navPlan: "El Plan",
    navPlatform: "La Plataforma",
    navParticipate: "Participa",
    navSign: "Firmar",
    madeBy: "Hecho altruistamente por"
  }
}[lang];
---

<!DOCTYPE html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <Analytics />
    <SpeedInsights />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    
    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;700;800;900&family=Work+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
    
    <style is:global>
      /* Custom typography classes using Google Fonts */
      body {
        font-family: 'Work Sans', sans-serif;
      }
      
      h1, h2, h3, h4, h5, h6, .font-display {
        font-family: 'Outfit', sans-serif;
      }

      /* Custom scrollbar */
      ::-webkit-scrollbar {
        width: 12px;
      }
      ::-webkit-scrollbar-track {
        background: #09090b;
      }
      ::-webkit-scrollbar-thumb {
        background: #dc2626;
        border: 3px solid #09090b;
      }
      ::-webkit-scrollbar-thumb:hover {
        background: #ef4444;
      }

      /* Lenis layout styling */
      html.lenis, html.lenis body {
        height: auto;
      }
      .lenis-smooth {
        scroll-behavior: auto !important;
      }
      .lenis-smooth [data-lenis-prevent] {
        overflow: clip;
      }
      .lenis-target {
        scroll-behavior: auto !important;
      }
      
      /* Keyboard Focus Rings */
      *:focus-visible {
        outline: 4px solid #dc2626 !important;
        outline-offset: 2px !important;
      }

      /* Active Navigation Link styling */
      nav a.active {
        color: #dc2626 !important;
        text-decoration-color: #dc2626 !important;
      }
      
      /* Mobile Menu open/close transition */
      #mobile-menu.open {
        transform: translateY(0);
        opacity: 1;
        pointer-events: auto;
      }
    </style>
  </head>
  <body class="min-h-screen bg-zinc-100 text-zinc-950 selection:bg-red-600 selection:text-white overflow-x-hidden">
    
    <!-- Header -->
    <header class="border-b-4 border-zinc-950 px-4 md:px-8 py-4 flex justify-between items-center uppercase font-black tracking-wider text-sm sticky top-0 bg-zinc-100 z-50 h-[72px]">
      <a href={lang === 'ca' ? '/' : '/es'} class="flex items-center hover:opacity-80 transition-opacity">
        <img 
          src={logoImg.src} 
          alt={t.brand} 
          class="h-12 w-auto object-contain border-2 border-zinc-950 shadow-[3px_3px_0px_0px_rgba(9,9,11,1)]" 
        />
      </a>
      
      <!-- Desktop Navigation Links -->
      <nav class="hidden lg:flex items-center gap-8 font-black uppercase text-xs tracking-widest text-zinc-950">
        <a href="#plan" class="hover:text-red-600 transition-colors underline underline-offset-4 decoration-2 decoration-transparent hover:decoration-red-600">{t.navPlan}</a>
        <a href="#plataforma" class="hover:text-red-600 transition-colors underline underline-offset-4 decoration-2 decoration-transparent hover:decoration-red-600">{t.navPlatform}</a>
        <a href="#participar" class="hover:text-red-600 transition-colors underline underline-offset-4 decoration-2 decoration-transparent hover:decoration-red-600">{t.navParticipate}</a>
        <a href="#signar" class="hover:text-red-600 transition-colors underline underline-offset-4 decoration-2 decoration-transparent hover:decoration-red-600">{t.navSign}</a>
      </nav>

      <div class="flex items-center gap-3">
         <span class="hidden sm:inline-block bg-red-600 text-white px-3 py-1 font-bold text-xs mr-3 border-2 border-zinc-950 shadow-[2px_2px_0px_0px_rgba(9,9,11,1)]">
           {t.headerBadge}
         </span>
         
         <div class="flex items-center border-2 border-zinc-950 shadow-[3px_3px_0px_0px_rgba(9,9,11,1)] overflow-hidden">
           <a 
             href="/" 
             class={`px-3 py-1 font-bold text-xs transition-colors ${lang === 'ca' ? 'bg-zinc-950 text-white' : 'bg-white text-zinc-950 hover:bg-zinc-200'}`}
           >
             CAT
           </a>
           <a 
             href="/es" 
             class={`px-3 py-1 font-bold text-xs border-l-2 border-zinc-950 transition-colors ${lang === 'es' ? 'bg-zinc-950 text-white' : 'bg-white text-zinc-950 hover:bg-zinc-200'}`}
           >
             ESP
           </a>
         </div>

          <!-- Mobile Menu Button -->
          <button 
            id="menu-toggle" 
            class="lg:hidden p-1.5 border-2 border-zinc-950 bg-white hover:bg-zinc-200 text-zinc-950 shadow-[2px_2px_0px_0px_rgba(9,9,11,1)] active:translate-x-0.5 active:translate-y-0.5 active:shadow-[1px_1px_0px_0px_rgba(9,9,11,1)] cursor-pointer flex items-center justify-center"
            aria-label="Menu"
          >
            <!-- Hamburger Icon -->
            <svg id="hamburger-icon" class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"></path>
            </svg>
            <!-- Close Icon (Hidden by default) -->
            <svg id="close-icon" class="w-5 h-5 hidden" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
          </button>
       </div>
    </header>

    <!-- Mobile Menu Overlay -->
    <div 
      id="mobile-menu" 
      class="fixed inset-x-0 top-[-300px] bg-zinc-100 border-b-4 border-zinc-950 p-6 flex flex-col gap-4 uppercase font-black tracking-wider text-sm transition-all duration-300 z-40 lg:hidden shadow-[0_10px_20px_rgba(0,0,0,0.15)] opacity-0 pointer-events-none"
    >
      <a href="#plan" class="mobile-nav-link py-3 border-b-2 border-zinc-200 hover:text-red-600 transition-colors">{t.navPlan}</a>
      <a href="#plataforma" class="mobile-nav-link py-3 border-b-2 border-zinc-200 hover:text-red-600 transition-colors">{t.navPlatform}</a>
      <a href="#participar" class="mobile-nav-link py-3 border-b-2 border-zinc-200 hover:text-red-600 transition-colors">{t.navParticipate}</a>
      <a href="#signar" class="mobile-nav-link py-3 hover:text-red-600 transition-colors">{t.navSign}</a>
    </div>

    <!-- Main Content Slot -->
    <main>
      <slot />
    </main>

    <!-- Footer -->
    <footer class="bg-zinc-950 text-zinc-50 px-6 md:px-12 py-16 flex flex-col gap-12 font-bold uppercase tracking-widest text-xs border-t-4 border-zinc-950">
      <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-8">
        <div>
          <img 
            src={logoImg.src} 
            alt={t.brand} 
            class="h-16 w-auto object-contain border-2 border-white shadow-[3px_3px_0px_0px_rgba(255,255,255,1)] mb-4" 
          />
          <p class="text-zinc-400">© {new Date().getFullYear()} {t.footerRights}</p>
          <p class="text-zinc-500 mt-1 font-medium">{t.footerTagline}</p>
        </div>
        <div class="flex flex-wrap gap-6 sm:gap-10">
          <a href="#" class="hover:text-red-500 transition-colors underline underline-offset-4 decoration-2 decoration-red-600/30 hover:decoration-red-600">{t.legal}</a>
          <a href="#" class="hover:text-red-500 transition-colors underline underline-offset-4 decoration-2 decoration-red-600/30 hover:decoration-red-600">{t.contact}</a>
        </div>
      </div>
      <div class="pt-8 border-t-2 border-zinc-900 text-zinc-500 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
        <div>
          {t.madeBy} <a href="https://elbalcodigital.com" target="_blank" rel="noopener noreferrer" class="text-white hover:text-red-500 transition-colors underline underline-offset-4 decoration-2 decoration-red-600/30 hover:decoration-red-600">elbalcodigital</a>
        </div>
        <div class="text-[10px] text-zinc-600 max-w-md normal-case font-normal leading-relaxed">
          Aquesta plataforma és una iniciativa ciutadana independent de denúncia i acció veïnal. No tenim vinculació amb cap partit polític ni entitat municipal.
        </div>
      </div>
    </footer>

    <!-- i18n redirection / client scripts -->
    <script>
      import Lenis from 'lenis';
      import { gsap } from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';

      gsap.registerPlugin(ScrollTrigger);

      // Smooth scroll with Lenis
      const lenis = new Lenis({
        duration: 1.1,
        easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
        orientation: 'vertical',
        gestureOrientation: 'vertical',
        smoothWheel: true,
        wheelMultiplier: 1,
        touchMultiplier: 1.5,
      });

      lenis.on('scroll', ScrollTrigger.update);

      gsap.ticker.add((time) => {
        lenis.raf(time * 1000);
      });

      gsap.ticker.lagSmoothing(0);

      // Save lenis to window object so other scripts can access it
      window.lenis = lenis;

      // GSAP Animations (initialized after layout load)
      document.addEventListener('DOMContentLoaded', () => {
        // Reduced motion check
        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        
        if (prefersReducedMotion) {
          console.log('Reduced motion preferred. Skipping scroll triggers.');
          return;
        }

        // Horizontal Gallery Pinning
        const galleryItems = gsap.utils.toArray('.gallery-item');
        const galleryScroll = document.querySelector('#gallery-scroll');
        const galleryContainer = document.querySelector('#gallery-container');

        if (galleryItems.length > 0 && galleryScroll && galleryContainer) {
          gsap.to(galleryItems, {
            xPercent: -100 * (galleryItems.length - 1),
            ease: "none",
            scrollTrigger: {
              trigger: galleryContainer,
              pin: true,
              scrub: 0.5,
              snap: 1 / (galleryItems.length - 1),
              // Start when top of container hits top of viewport
              start: "top top",
              // End based on scroll width of horizontal container
              end: () => "+=" + (galleryScroll.scrollWidth - window.innerWidth),
              invalidateOnRefresh: true,
            }
          });

          // Horizontal scroll progress bar
          gsap.to('#scroll-progress', {
            scaleX: 1,
            ease: 'none',
            scrollTrigger: {
              trigger: galleryContainer,
              start: 'top top',
              end: () => "+=" + (galleryScroll.scrollWidth - window.innerWidth),
              scrub: true,
            }
          });
        }

        // Fade in reveals for stark design elements
        const fadeRevealItems = gsap.utils.toArray('.scroll-reveal');
        fadeRevealItems.forEach((item: any) => {
          gsap.fromTo(item, 
            { opacity: 0, y: 40 },
            {
              opacity: 1,
              y: 0,
              duration: 0.8,
              ease: "power2.out",
              scrollTrigger: {
                trigger: item,
                start: "top 88%",
                toggleActions: "play none none none"
              }
            }
          );
        });

        // Split text character/word reveal for hero headline
        const wordReveal = document.querySelectorAll('.hero-word-reveal');
        if (wordReveal.length > 0) {
          gsap.from(wordReveal, {
            opacity: 0,
            y: 30,
            duration: 0.6,
            stagger: 0.1,
            ease: 'power3.out',
            delay: 0.3
          });
        }
        // Mobile Menu Toggle
        const menuToggle = document.getElementById('menu-toggle');
        const mobileMenu = document.getElementById('mobile-menu');
        const hamburgerIcon = document.getElementById('hamburger-icon');
        const closeIcon = document.getElementById('close-icon');
        const mobileNavLinks = document.querySelectorAll('.mobile-nav-link');

        if (menuToggle && mobileMenu) {
          menuToggle.addEventListener('click', () => {
            const isOpen = mobileMenu.classList.toggle('open');
            if (isOpen) {
              mobileMenu.classList.remove('top-[-300px]', 'opacity-0', 'pointer-events-none');
              mobileMenu.classList.add('top-[72px]', 'opacity-100', 'pointer-events-auto');
              hamburgerIcon?.classList.add('hidden');
              closeIcon?.classList.remove('hidden');
            } else {
              mobileMenu.classList.add('top-[-300px]', 'opacity-0', 'pointer-events-none');
              mobileMenu.classList.remove('top-[72px]', 'opacity-100', 'pointer-events-auto');
              hamburgerIcon?.classList.remove('hidden');
              closeIcon?.classList.add('hidden');
            }
          });

          // Close mobile menu on link click
          mobileNavLinks.forEach(link => {
            link.addEventListener('click', () => {
              mobileMenu.classList.remove('open');
              mobileMenu.classList.add('top-[-300px]', 'opacity-0', 'pointer-events-none');
              mobileMenu.classList.remove('top-[72px]', 'opacity-100', 'pointer-events-auto');
              hamburgerIcon?.classList.remove('hidden');
              closeIcon?.classList.add('hidden');
            });
          });
        }

        // Scroll Spy / Active Links Highlighter
        const sections = document.querySelectorAll('section[id]');
        const navLinks = document.querySelectorAll('nav a');
        
        const scrollSpyOptions = {
          root: null,
          rootMargin: '-20% 0px -60% 0px',
          threshold: 0
        };

        const scrollSpyCallback = (entries: any[]) => {
          entries.forEach((entry: any) => {
            if (entry.isIntersecting) {
              const id = entry.target.getAttribute('id');
              
              // Desktop active styling
              navLinks.forEach((link: any) => {
                if (link.getAttribute('href') === `#${id}`) {
                  link.classList.add('active');
                } else {
                  link.classList.remove('active');
                }
              });

              // Mobile active styling
              mobileNavLinks.forEach((link: any) => {
                if (link.getAttribute('href') === `#${id}`) {
                  link.classList.add('text-red-600');
                } else {
                  link.classList.remove('text-red-600');
                }
              });
            }
          });
        };

        if (typeof window !== 'undefined' && 'IntersectionObserver' in window) {
          const observer = new IntersectionObserver(scrollSpyCallback, scrollSpyOptions);
          sections.forEach(section => observer.observe(section));
        }

        // Intercept hash links for smooth scroll with header offset
        document.querySelectorAll('a[href^="#"]').forEach((anchor: any) => {
          anchor.addEventListener('click', (e: Event) => {
            const href = anchor.getAttribute('href');
            if (href === '#' || !href) return;
            
            const target = document.getElementById(href.substring(1));
            if (target && window.lenis) {
              e.preventDefault();
              window.lenis.scrollTo(target, { offset: -72 });
            }
          });
        });
      });
    </script>
  </body>
</html>
